# Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file with real secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Authentication (Clerk) ───────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── End-to-End Testing (Playwright) ──────────────────────────────────────────
# Test only. Create the per-role test users manually in the auth provider first.
# One E2E_[ROLE]_EMAIL line per role in the permission matrix. The three below
# mirror the default ROLES array in e2e/support/auth.ts and the role variables
# set by the test workflow — delete any role this project does not have, and
# add a line for any role it adds.
E2E_ADMIN_EMAIL=
E2E_MANAGER_EMAIL=
E2E_MEMBER_EMAIL=
# Shared by every test user above.
E2E_USER_PASSWORD=
E2E_BASE_URL=

# ─── Add your project-specific variables below ────────────────────────────────
# Keep this file in sync with docs/general_docs/TECH_STACK.md
# (Environment Variables & Secrets Management section)
